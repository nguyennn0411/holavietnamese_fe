# =============================================================================
# HOLA VIETNAMESE FRONTEND - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and replace only the values needed locally.
# Never commit .env, .env.local, credentials, or provider API keys.
# Only variables prefixed with VITE_ are exposed to browser code.
# =============================================================================

# Backend API
# Local development uses the Spring Boot backend on port 8080.
# For a same-origin production deployment, set this to the public API origin
# or leave it empty only when every client uses the /api reverse proxy.
VITE_API_BASE_URL=http://localhost:8080

# Vite development proxy target for /api and /media requests.
VITE_PROXY_TARGET=http://localhost:8080

# Google Identity Services (optional)
# Example format: 123456789-example.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# AI display/request configuration (optional)
# Provider secrets belong in the backend environment, never in this file.
VITE_AI_PROVIDER=openrouter
VITE_AI_MODEL=openrouter/free
VITE_AI_REQUEST_TIMEOUT_MS=60000

# Development-only local fallback when the backend AI response is unavailable.
# Keep false in normal and production environments.
VITE_AI_ALLOW_OFFLINE_FALLBACK=false
